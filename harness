#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# lock 모드 fresh clone 자가 부트스트랩 (specs/006 후속). clone 직후에는
# 공유 스크립트가 materialize 되지 않아 어떤 하위 명령도 실행할 수 없다.
# 최소 셸만으로 harness.lock을 읽어 패키지를 한 번 수신하고, 이후 단계는
# 패키지 안의 정식 스크립트(materialize/pkg-sync)에 위임한다.
ensure_lock_bootstrap() {
  [ -f "$ROOT_DIR/harness.lock" ] || return 0
  [ ! -e "$ROOT_DIR/.harness/scripts/pkg/pkg-sync.sh" ] || return 0
  lock_repo="$(sed -n 's/.*"repo"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT_DIR/harness.lock" | head -n 1)"
  [ -n "$lock_repo" ] || lock_repo="https://github.com/CODIWORKS-Engineer/codi-harness.git"
  lock_version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' "$ROOT_DIR/harness.lock" | head -n 1)"
  if [ -z "$lock_version" ]; then
    # 채널 모드 첫 수신은 최신 안정 태그로 시작한다. 채널 정밀 해석
    # (latest-minor의 major 고정)은 직후 pkg-sync가 정본으로 수행한다.
    # stderr를 버리지 않는다: 업스트림이 private일 때 인증 실패가 여기서
    # 조용히 사라지면 "태그 없음"으로 오인된다 (CI 실측).
    ls_remote_err="$(mktemp)"
    lock_version="$(git ls-remote --tags "$lock_repo" 'v[0-9]*' 2>"$ls_remote_err" \
      | sed -n 's|.*refs/tags/v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' \
      | sort -t . -k 1,1n -k 2,2n -k 3,3n | tail -n 1)"
  fi
  if [ -z "$lock_version" ]; then
    echo "harness.lock 부트스트랩 실패: $lock_repo 에서 버전 태그를 찾지 못했습니다." >&2
    if [ -n "${ls_remote_err:-}" ] && [ -s "$ls_remote_err" ]; then
      echo "git 원인:" >&2
      sed 's/^/  /' "$ls_remote_err" >&2
      echo "업스트림이 private이면 읽기 권한이 있는 자격증명이 필요합니다" >&2
      echo "(CI에서는 checkout 이후 하네스 레포 읽기 토큰을 git credential 또는" >&2
      echo " git config url.\"https://x-access-token:<token>@github.com/\".insteadOf 로 주입하세요)." >&2
    else
      echo "네트워크 연결과 업스트림 릴리스(vX.Y.Z 태그) 존재를 확인 후 재실행하세요." >&2
    fi
    rm -f "${ls_remote_err:-}"
    exit 1
  fi
  rm -f "${ls_remote_err:-}"
  cache_dir="${CODI_HARNESS_CACHE_DIR:-$HOME/.codi-harness}"
  pkg_dir="$cache_dir/versions/$lock_version"
  if [ ! -d "$pkg_dir" ]; then
    partial="$cache_dir/versions/$lock_version.partial.$$"
    mkdir -p "$cache_dir/versions"
    if ! git clone --quiet --depth 1 --branch "v$lock_version" "$lock_repo" "$partial"; then
      rm -rf "$partial"
      echo "harness.lock 부트스트랩 실패: v$lock_version 수신 불가. 네트워크와 태그 존재를 확인 후 재실행하세요." >&2
      exit 1
    fi
    mv "$partial" "$pkg_dir"
  fi
  (cd "$ROOT_DIR" && sh "$pkg_dir/.harness/scripts/pkg/materialize.sh" "$lock_version")
  echo "lock 부트스트랩 완료: v$lock_version (채널 정본 동기화는 pkg-sync가 이어서 수행)"
}
ensure_lock_bootstrap

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$cmd" in
  bootstrap)
    exec "$ROOT_DIR/.harness/scripts/setup/bootstrap.sh" "$@"
    ;;
  install)
    # lock 모드(specs/005) 다운스트림이면 패키지 동기화를 먼저 수행한다.
    if [ -f "$ROOT_DIR/harness.lock" ]; then
      (cd "$ROOT_DIR" && sh "$ROOT_DIR/.harness/scripts/pkg/pkg-sync.sh")
    fi
    exec "$ROOT_DIR/.harness/scripts/setup/install.sh" "$@"
    ;;
  pkg-sync)
    cd "$ROOT_DIR"
    exec sh "$ROOT_DIR/.harness/scripts/pkg/pkg-sync.sh" "$@"
    ;;
  pkg-gc)
    cd "$ROOT_DIR"
    exec sh "$ROOT_DIR/.harness/scripts/pkg/pkg-gc.sh" "$@"
    ;;
  migrate)
    cd "$ROOT_DIR"
    exec sh "$ROOT_DIR/.harness/scripts/pkg/migrate.sh" "$@"
    ;;
  doctor)
    exec "$ROOT_DIR/.harness/scripts/checks/doctor.sh" "$@"
    ;;
  context-check)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/checks/context-check.mjs" "$@"
    ;;
  rule-check)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/checks/rule-check.mjs" "$@"
    ;;
  secret-surface-check)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/checks/secret-surface-check.mjs" "$@"
    ;;
  package-policy-check)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/checks/package-policy-check.mjs" "$@"
    ;;
  pin)
    cd "$ROOT_DIR"
    exec sh "$ROOT_DIR/.harness/scripts/pkg/pin.sh" "$@"
    ;;
  release)
    cd "$ROOT_DIR"
    exec sh "$ROOT_DIR/.harness/scripts/pkg/release-check.sh" "$@"
    ;;
  update)
    # lock 모드에서 --major는 패키지 major 전환 (specs/005 FR-005)
    if [ "${1:-}" = "--major" ] && [ -f "$ROOT_DIR/harness.lock" ]; then
      cd "$ROOT_DIR"
      exec sh "$ROOT_DIR/.harness/scripts/pkg/pkg-update-major.sh"
    fi
    exec "$ROOT_DIR/.harness/scripts/setup/update.sh" "$@"
    ;;
  update-check)
    exec "$ROOT_DIR/.harness/scripts/setup/update-check.sh" "$@"
    ;;
  speckit-vendor)
    exec "$ROOT_DIR/.harness/scripts/setup/speckit-vendor.sh" "$@"
    ;;
  manifest)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/setup/generate-manifest.mjs" "$@"
    ;;
  skills-link)
    exec "$ROOT_DIR/.harness/scripts/setup/skills-link.sh" "$@"
    ;;
  profile)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/tooling/profile.mjs" "$@"
    ;;
  role)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/tooling/role.mjs" "$@"
    ;;
  workflow-check)
    exec "$ROOT_DIR/.harness/scripts/checks/workflow-check.sh" "$@"
    ;;
  codex-replay-check)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/checks/codex-replay-check.mjs" "$@"
    ;;
  notify-decision)
    exec mise exec -- node "$ROOT_DIR/.harness/scripts/agent/notify.mjs" decision "$@"
    ;;
  init-project)
    exec "$ROOT_DIR/.harness/scripts/setup/init-project.sh" "$@"
    ;;
  new-project)
    exec "$ROOT_DIR/.harness/scripts/setup/new-project-skeleton.sh" "$@"
    ;;
  gstack-cleanup)
    exec "$ROOT_DIR/.harness/scripts/setup/gstack-cleanup.sh" "$@"
    ;;
  prune-downstream)
    # HARNESS_ROOT 를 명시해 캐시 경유 실행에서도 레포 루트가 흔들리지 않게
    # 한다 (감사 L-2 — 다른 node 서브커맨드와 호출 규약 통일).
    exec env HARNESS_ROOT="$ROOT_DIR" mise exec -- node "$ROOT_DIR/.harness/scripts/setup/prune-downstream.mjs" "$@"
    ;;
  wire-infisical)
    exec "$ROOT_DIR/.harness/scripts/setup/wire-infisical.sh" "$@"
    ;;
  codex)
    "$ROOT_DIR/.harness/scripts/agent/agent-preflight.sh" codex
    exec codex "$@"
    ;;
  claude)
    "$ROOT_DIR/.harness/scripts/agent/agent-preflight.sh" claude
    exec claude "$@"
    ;;
  help|--help|-h)
    # 기본 도움말은 일상 명령 4개만 싣는다 (specs/014 FR-004). 나머지는
    # 숨김이지 제거가 아니며 --all 로 전부 볼 수 있다 — 팀원이 매일 외워야
    # 하는 표면을 좁히는 것이 목적이다.
    if [ "${1:-}" != "--all" ]; then
      cat <<'EOF'
사용법:
  ./harness bootstrap     하네스 준비·갱신 (최초 설치와 일상 갱신 모두 이 명령)
  ./harness doctor        로컬 하네스 상태 점검
  ./harness codex         공통 preflight 실행 후 Codex 시작
  ./harness claude        공통 preflight 실행 후 Claude Code 시작

전체 명령 목록: ./harness help --all
EOF
      exit 0
    fi
    cat <<'EOF'
사용법: ./harness <명령> [옵션]

일상:
  ./harness bootstrap     하네스 준비·갱신 (최초 설치와 일상 갱신 모두 이 명령)
  ./harness doctor        로컬 하네스 상태 점검
  ./harness codex         공통 preflight 실행 후 Codex 시작
  ./harness claude        공통 preflight 실행 후 Claude Code 시작

점검:
  ./harness context-check AGENTS.md / CLAUDE.md 컨텍스트 정합성 점검
  ./harness rule-check    네이티브 rule 파일 문서화/연결 상태 점검
  ./harness secret-surface-check
                           GitHub Secret 및 .env.example 노출면 점검
  ./harness package-policy-check
                           패키지 매니저 및 lockfile 정책 점검
  ./harness workflow-check actionlint 사용 가능 시 GitHub Actions workflow 점검
  ./harness codex-replay-check <transcript.md>
                           Codex goal/session transcript 라우팅 회귀 점검

패키지 관리:
  ./harness install       하네스 통합 도구를 설치하거나 갱신
  ./harness update        copy 모드 shared 하네스 적용 (lock 모드 major 전환은 --major; --check 는 Superpowers 설치 상태 안내 — 하네스 버전 확인은 update-check)
  ./harness pin <ver>     lock 모드 버전 고정/롤백 (--channel latest-minor 로 채널 복귀)
  ./harness pkg-sync      lock 모드 수동 동기화 (수신+materialize)
  ./harness pkg-gc        버전 캐시 정리 — 미참조 구버전 제거 (--dry-run 지원)
  ./harness migrate       기존 레포를 lock 모드로 전환 (--dry-run 지원)
  ./harness update-check  일/주 단위 업데이트 확인 실행

레포 운영:
  ./harness release <vX.Y.Z>
                           릴리스 검증 + annotated tag 생성 (하네스 레포 전용 수동 fallback;
                           정본 경로는 v2 머지 시 CI release.yml 자동 발행)
  ./harness manifest      .harness/shared-manifest.json 재생성 (하네스 레포 전용)
  ./harness skills-link   .claude/skills 및 .agents/skills 머지 트리 재생성
  ./harness init-project  모노레포 초기화
  ./harness new-project <dir>
                           새 프로젝트 최소 스켈레톤 생성 (런처+lock, 이후 bootstrap)
  ./harness gstack-cleanup [--apply]
                           전역 이전 게이트 도구 잔재 정리 (기본 check, --apply 삭제)
  ./harness prune-downstream [--apply]
                           다운스트림에 남은 upstream 전용 파일 체크/정리 (기본 check)
  ./harness wire-infisical <name>
                           Infisical 콘솔 작업 후 _PROJECT_ID_ 치환과 GitHub Secrets 등록
  ./harness speckit-vendor <tag>
                           고정 릴리스 태그의 Spec Kit 공용 자산을 vendoring
  ./harness profile       프로젝트 profile mode 조회/변경
  ./harness role          개발자 role 마커 조회/설정 (front|back|fullstack)
  ./harness notify-decision 사용자 결정이 필요함을 알림
EOF
    ;;
  *)
    echo "알 수 없는 명령입니다: $cmd" >&2
    echo "./harness help 를 실행해 사용법을 확인하세요." >&2
    exit 2
    ;;
esac
