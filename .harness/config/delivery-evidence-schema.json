{
  "$schema": "https://codi.works/harness/delivery-evidence-schema.v1.json",
  "version": 1,
  "kind": "delivery-evidence",
  "ownership": "downstream-collector-generated-snapshot",
  "generated": true,
  "description": "Downstream facts linked to an exact consumed planning digest.",
  "requiredFields": ["schemaVersion", "projectId", "consumedManifestDigest", "sourceRevision", "collectedAt"],
  "optionalFields": ["workItems", "features"],
  "preferredDeliveryField": "workItems",
  "legacyCompatibility": {
    "field": "features",
    "mode": "read-only-projection"
  },
  "certaintyValues": ["confirmed", "observed", "inferred"]
}
