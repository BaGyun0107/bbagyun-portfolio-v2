{
  "$schema": "https://codi.works/harness/feature-work-item-schema.v1.json",
  "version": 1,
  "kind": "feature-work-item",
  "ownership": "project-delivery-source",
  "generated": false,
  "description": "Project-owned implementation work linked 1:N to planning-owned feature definitions.",
  "requiredFields": ["id", "featureDefinitionId", "workType", "title", "releaseId", "status", "taskRefs", "evidenceRefs"],
  "completionRequiredFields": ["requiredAcceptanceCriterionIds", "acceptanceResults"],
  "statuses": ["planned", "in-progress", "in-review", "done"],
  "workTypes": ["frontend", "backend", "db", "qa", "infra", "unspecified"],
  "repositoryFieldAllowed": false,
  "holdFields": ["active", "reason", "releaseCondition"]
}
