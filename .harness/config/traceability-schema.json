{
  "$schema": "https://codi.works/harness/traceability-schema.v1.json",
  "version": 1,
  "description": "Canonical contract for optional typed feature traceability.",
  "sourcePath": "data/feature-relations.json",
  "ownership": "human-owned artifact — docs:build reads it and never writes it",
  "requiredRootFields": ["version", "entities", "links"],
  "entityTypes": ["need", "feature", "screen", "flow", "spec", "design", "api", "data", "test", "verification"],
  "supplementalEntityTypes": ["need", "design", "api", "data", "test"],
  "relationTypes": ["satisfied-by", "appears-on", "uses", "specified-by", "designed-by", "depends-on", "verified-by"],
  "requiredEntityFields": ["type", "id", "title"],
  "requiredLinkFields": ["from", "to", "type"],
  "failOpen": "파일 부재/파싱 실패/최상위 구조 위반은 null, 개별 항목 위반은 제외 후 경고"
}
