{
  "description": "What the harness guarantees in every downstream .gitignore. `entries` are single lines appended idempotently when missing. `lockModeEntries` apply only in lock mode for paths materialize provides as symlinks; `{pattern, real: true}` marks install-managed real directories that skip the symlink check. `managedBlocks` are harness-owned regions between marker comments: their body is replaced to match `lines`, and any `neutralize` pattern found OUTSIDE the block as a bare line is commented out. Everything outside managed blocks (and non-required entries) is project-owned and never modified. Applied by ensure-gitignore.mjs — via update.sh in copy mode, via pkg-sync.sh in lock mode.",
  "entries": [
    ".claude/skills",
    ".agents/skills",
    ".claude/rules/local"
  ],
  "lockModeEntries": [
    ".harness/current",
    ".harness/docs",
    ".harness/hooks",
    ".harness/policies",
    ".harness/scripts/agent",
    ".harness/scripts/docs",
    ".harness/scripts/pkg",
    ".harness/scripts/setup",
    ".harness/scripts/tooling",
    ".harness/scripts/checks/*",
    "!.harness/scripts/checks/ci-node-verify.sh",
    ".harness/scripts/deploy/*",
    "!.harness/scripts/deploy/node-package-manager.sh",
    ".harness/scripts/audit/*",
    "!.harness/scripts/audit/osv-severity-gate.js",
    "!.harness/scripts/audit/dependency-impact-report.js",
    ".harness/imported-rules",
    ".harness/prompt-style",
    ".harness/vendor",
    ".harness/skills",
    ".harness/workflow.md",
    ".harness/manifest.json",
    ".harness/lock.json",
    ".harness/shared-manifest.json",
    ".harness/config/change-proposal-schema.json",
    ".harness/config/codi-config.yaml",
    ".harness/config/delivery-evidence-schema.json",
    ".harness/config/feature-definition-schema.json",
    ".harness/config/feature-detail-schema.json",
    ".harness/config/feature-work-item-schema.json",
    ".harness/config/hub-workspace-schema.json",
    ".harness/config/planning-manifest-schema.json",
    ".harness/config/required-gitignore.json",
    ".harness/config/sitemap-schema.json",
    ".harness/config/skill-triggers.json",
    ".harness/config/tool-permissions.json",
    ".harness/config/traceability-schema.json",
    ".harness/config/user-flow-schema.json",
    { "pattern": ".specify/templates", "real": true },
    { "pattern": ".specify/scripts", "real": true },
    { "pattern": ".specify/workflows", "real": true },
    ".claude/rules/shared",
    ".claude/settings.json",
    ".codex/rules",
    ".codex/hooks.json",
    ".codex/config.example.toml",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "lint-staged.config.mjs",
    "docs/harness-overview.md",
    "docs/planning-hub-handoff.md",
    "docs/feature-definition-planning-hub-guide.md"
  ],
  "managedBlocks": [
    {
      "id": "planning",
      "header": "# >>> codi-harness managed (.planning) — do not edit between markers >>>",
      "footer": "# <<< codi-harness managed (.planning) <<<",
      "lines": [
        "# Legacy planning state is scheduled for removal",
        "# (docs/audits/2026-07-07-planning-retirement.md); until deleted, do not",
        "# ignore it — removal goes through git rm, not ignore."
      ],
      "neutralize": [
        ".planning",
        ".planning/",
        ".planning/*",
        ".planning/**"
      ]
    },
    {
      "id": "lock-scripts",
      "header": "# >>> codi-harness managed (lock scripts) — do not edit between markers >>>",
      "footer": "# <<< codi-harness managed (lock scripts) <<<",
      "lines": [
        "# .harness/scripts 는 통째로 무시하지 않는다: CI가 호출하는",
        "# KEEP_COMMITTED 스크립트(checks/deploy/audit)는 커밋되어야 하고,",
        "# 링크로 제공되는 하위만 lockModeEntries 가 개별 등재한다."
      ],
      "neutralize": [
        ".harness/scripts",
        ".harness/scripts/",
        ".harness/scripts/*",
        ".harness/scripts/**"
      ]
    }
  ]
}
