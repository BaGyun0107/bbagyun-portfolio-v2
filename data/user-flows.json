        { "id": "manual-guide", "title": "최종 요약에 수동 설치 절차를 표시한다", "kind": "system", "screenIds": ["HUB-GUIDE"], "featureIds": ["004-onboarding-bootstrap"], "next": [{ "to": "doctor" }] },
        { "id": "doctor", "title": "doctor 검증이 통과하는가?", "kind": "decision", "featureIds": ["004-onboarding-bootstrap"], "next": [{ "to": "ready", "condition": "통과" }, { "to": "retry", "condition": "실패" }] },
        { "id": "retry", "title": "완료 상태를 보존하고 원인·다음 행동·재실행을 안내한다", "kind": "end", "screenIds": ["HUB-GUIDE"], "featureIds": ["004-onboarding-bootstrap"] },
