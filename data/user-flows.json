        { "id": "approve-done", "title": "상태 전이 제안을 사람이 명시적으로 승인한다", "kind": "action", "screenIds": ["HUB-STATUS-BOARD"], "featureIds": ["002-feature-hub", "008-linked-feature-hub"], "next": [{ "to": "delivery-complete" }] },
