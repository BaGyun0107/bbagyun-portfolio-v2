        { "id": "supported-os", "title": "지원하는 macOS인가?", "kind": "decision", "featureIds": ["004-onboarding-bootstrap"], "next": [{ "to": "prepare-tools", "condition": "macOS" }, { "to": "unsupported", "condition": "Linux 또는 Windows" }] },
