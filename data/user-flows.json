        { "id": "authenticated", "title": "GitHub 인증이 완료됐는가?", "kind": "decision", "featureIds": ["004-onboarding-bootstrap"], "next": [{ "to": "install-harness", "condition": "인증됨" }, { "to": "login", "condition": "미인증" }] },
