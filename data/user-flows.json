        { "id": "publish", "title": "검증된 semver 버전을 발행한다", "kind": "action", "featureIds": ["005-harness-packaging"], "next": [{ "to": "automatic-channel" }] },
        { "id": "automatic-channel", "title": "minor/patch 자동 채널인가?", "kind": "decision", "featureIds": ["005-harness-packaging"], "next": [{ "to": "materialize", "condition": "자동 minor/patch" }, { "to": "approve-version", "condition": "major 또는 pin" }] },
        { "id": "approve-version", "title": "명시적으로 버전을 승인하고 lock을 변경한다", "kind": "action", "featureIds": ["005-harness-packaging"], "next": [{ "to": "materialize" }] },
        { "id": "materialize", "title": "다음 세션에서 캐시 수신과 원자적 materialize를 수행한다", "kind": "system", "featureIds": ["005-harness-packaging"], "next": [{ "to": "materialized" }] },
        { "id": "materialized", "title": "버전 수신과 materialize가 성공했는가?", "kind": "decision", "featureIds": ["005-harness-packaging"], "next": [{ "to": "existing-project", "condition": "성공" }, { "to": "keep-current", "condition": "오프라인 또는 수신 실패" }] },
        { "id": "keep-current", "title": "현재 버전을 유지하고 부분 적용 없이 다음 행동을 안내한다", "kind": "end", "screenIds": ["HUB-GUIDE"], "featureIds": ["005-harness-packaging"] },
        { "id": "existing-project", "title": "기존 복사형 다운스트림인가?", "kind": "decision", "featureIds": ["006-harness-migrate"], "next": [{ "to": "dry-run", "condition": "기존 복사형" }, { "to": "doctor", "condition": "신규 lock 프로젝트" }] },
        { "id": "dry-run", "title": "migrate dry-run 결과와 diff를 검토한다", "kind": "action", "screenIds": ["HUB-GUIDE"], "featureIds": ["006-harness-migrate"], "next": [{ "to": "safe-worktree" }] },
        { "id": "safe-worktree", "title": "워킹트리가 깨끗하고 공유 파일 로컬 수정이 없는가?", "kind": "decision", "featureIds": ["006-harness-migrate"], "next": [{ "to": "migrate", "condition": "안전" }, { "to": "preserve", "condition": "dirty 또는 로컬 수정" }] },
        { "id": "preserve", "title": "변경 없이 중단하고 기존 데이터를 보존한다", "kind": "end", "screenIds": ["HUB-GUIDE"], "featureIds": ["006-harness-migrate"] },
        { "id": "migrate", "title": "lock 방식으로 migrate한다", "kind": "system", "featureIds": ["006-harness-migrate"], "next": [{ "to": "doctor" }] },
        { "id": "doctor", "title": "doctor와 기능 동등성 검증이 통과하는가?", "kind": "decision", "featureIds": ["005-harness-packaging", "006-harness-migrate"], "next": [{ "to": "review-diff", "condition": "통과" }, { "to": "restore", "condition": "실패" }] },
        { "id": "restore", "title": "원인을 기록하고 이전 상태를 유지하거나 복원한다", "kind": "end", "screenIds": ["HUB-GUIDE"], "featureIds": ["005-harness-packaging", "006-harness-migrate"] },
        { "id": "review-diff", "title": "팀이 최종 diff를 리뷰한다", "kind": "action", "screenIds": ["HUB-DEFINITIONS-DETAIL"], "featureIds": ["006-harness-migrate"], "next": [{ "to": "delivered" }] },
        { "id": "delivered", "title": "사용자가 커밋하거나 기존 상태로 복원한다", "kind": "end", "featureIds": ["006-harness-migrate"] }
